{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@tsconfig/node26/tsconfig.json", "@tsconfig/node-ts/tsconfig.json"],

  "compilerOptions": {
    // Soundness. The bases set neither `strict` nor the checks below.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Emit. `erasableSyntaxOnly` and `verbatimModuleSyntax` come from @tsconfig/node-ts.
    "isolatedModules": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "forceConsistentCasingInFileNames": true,
    "customConditions": ["development"]
  }
}
